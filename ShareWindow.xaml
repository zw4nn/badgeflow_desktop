<Window x:Class="BadgeFlow.Desktop.ShareWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Partager" Width="780" Height="700" MinWidth="700" MinHeight="620" WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Icon="Assets/BadgeFlow.ico">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="Partager les badges" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ResidenceText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Résidents" Style="{StaticResource SectionTitle}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ResidentsPanel"/></ScrollViewer></Grid></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Colonnes CSV / Excel" Style="{StaticResource SectionTitle}"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ColumnsPanel"/></ScrollViewer></Grid></Border>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="CSV sans accents · un badge par ligne · résident seulement sur la première ligne" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="Copier le texte" Style="{StaticResource SecondaryButton}" Margin="8,0" Click="CopyText_Click"/>
      <Button Grid.Column="2" Content="Exporter CSV" Style="{StaticResource PrimaryButton}" Click="ExportCsv_Click"/>
    </Grid></Border>
  </Grid>
</Window>
