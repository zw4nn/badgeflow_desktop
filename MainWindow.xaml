<Window x:Class="BadgeFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BadgeFlow Desktop" Width="1320" Height="840" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/BadgeFlow.ico"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip" SizeToContent="Manual">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BadgeFlow Desktop" FontSize="25" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#AEB6C4" Margin="0,3,7,0"/>
                        <TextBlock x:Name="StatusText" Text="Recherche du lecteur FDI…" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Mode :" Foreground="{StaticResource MutedBrush}" Margin="20,0,7,0"/>
                        <ComboBox x:Name="ReaderModeBox" Width="165" Height="30" MinHeight="30" SelectionChanged="ReaderModeBox_SelectionChanged">
                            <ComboBoxItem Content="Automatique"/><ComboBoxItem Content="Urmet / Hexact"/><ComboBoxItem Content="Intratone"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="TotalsText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="Base locale · export CSV Excel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="*" MinWidth="430"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="285" MinWidth="230"/>
            </Grid.ColumnDefinitions>

            <!-- RESIDENCES / RESIDENTS -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Résidence" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="ResidenceBox" Grid.Row="1" Margin="0,0,0,8" SelectionChanged="ResidenceBox_SelectionChanged"/>
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Nouvelle" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0" Click="CreateResidence_Click"/>
                        <Button Grid.Column="1" Content="Modifier" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="EditResidence_Click"/>
                    </Grid>
                    <Button Grid.Row="3" Content="Supprimer la résidence" Style="{StaticResource DangerButton}" Margin="0,0,0,14" Click="DeleteResidence_Click"/>
                    <TextBlock Grid.Row="4" Text="Résidents" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
                    <TextBox x:Name="SearchBox" Grid.Row="5" ToolTip="Nom, prénom, logement ou numéro de badge" TextChanged="SearchBox_TextChanged" Margin="0,0,0,8"/>
                    <ListBox x:Name="ResidentList" Grid.Row="6" MouseDoubleClick="ResidentList_MouseDoubleClick"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- RESIDENT FORM -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="16,14,16,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fiche résident" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ModeText" Grid.Column="1" Text="Nouveau résident" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="16,12,12,16">
                        <StackPanel>
                            <TextBlock Text="Identité" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Nom *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LastNameBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Prénom" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FirstNameBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Téléphone" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhoneBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="E-mail" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EmailBox"/></StackPanel>
                            </Grid>

                            <TextBlock Text="Logement" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Bâtiment" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BuildingBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Appartement" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ApartmentBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Étage" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FloorBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Porte" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DoorBox"/></StackPanel>
                            </Grid>

                            <TextBlock Text="Badges" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#F5F8FF" BorderBrush="#DCE5FF" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,0,9">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Dernière lecture" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="LastBadgeText" Text="Posez un badge sur le lecteur" FontFamily="Consolas" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,8,0" TextWrapping="Wrap"/></StackPanel>
                                    <Button Grid.Column="1" Content="Ajouter manuel" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="AddManualBadge_Click"/>
                                </Grid>
                            </Border>
                            <DataGrid x:Name="BadgeGrid" Height="190" MinHeight="120" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Numéro" Binding="{Binding Number}" Width="*"/>
                                    <DataGridTextColumn Header="Technologie" Binding="{Binding Technology}" Width="120"/>
                                    <DataGridCheckBoxColumn Header="Starprox" Binding="{Binding Starprox}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Modifier le badge" Style="{StaticResource SecondaryButton}" Click="EditBadge_Click"/>
                                <Button Grid.Column="2" Content="Retirer le badge" Style="{StaticResource DangerButton}" Click="RemoveBadge_Click"/>
                            </Grid>

                            <TextBlock Text="Notes" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Informations complémentaires sur le résident" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="NotesBox" Height="90" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

            <!-- ACTIONS -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel>
                        <TextBlock Text="Enregistrement" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Enregistrer le résident" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7" Click="SaveResident_Click"/>
                        <Button Content="Enregistrer et passer au suivant" Style="{StaticResource SecondaryButton}" Margin="0,0,0,7" Click="SaveNext_Click"/>
                        <Button Content="Nouvelle fiche résident" Style="{StaticResource SecondaryButton}" Margin="0,0,0,18" Click="NewResident_Click"/>

                        <Separator Margin="0,0,0,16" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="Partage et données" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Partager / Export CSV" Style="{StaticResource PrimaryButton}" Margin="0,0,0,7" Click="Share_Click"/>
                        <Button Content="Exporter la résidence" Style="{StaticResource SecondaryButton}" Margin="0,0,0,7" Click="ExportResidence_Click"/>
                        <Button Content="Importer un CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,0,7" Click="ImportCsv_Click"/>
                        <Button Content="Sauvegarder la base" Style="{StaticResource SecondaryButton}" Margin="0,0,0,18" Click="BackupDatabase_Click"/>

                        <Border Background="#F7F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Raccourcis" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="Double-clic : ouvrir un résident\nCtrl + Entrée : enregistrer et suivant\nÉchap : vider la fiche" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,9" Margin="0,10,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Prêt" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Column="1" Text="BadgeFlow Desktop 1.3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
