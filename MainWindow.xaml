<Window x:Class="BadgeFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BadgeFlow Desktop" Width="1440" Height="900" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" Icon="Assets/BadgeFlow.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BadgeFlow Desktop" FontSize="28" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#AEB6C4" Margin="0,3,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Recherche du lecteur FDI…" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="  •  Mode lecture :" Foreground="{StaticResource MutedBrush}" Margin="18,0,8,0"/>
                        <ComboBox x:Name="ReaderModeBox" Width="180" Height="30" SelectionChanged="ReaderModeBox_SelectionChanged">
                            <ComboBoxItem Content="Automatique"/><ComboBoxItem Content="Urmet / Hexact"/><ComboBoxItem Content="Intratone"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalsText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="Base locale sécurisée · export CSV compatible Excel" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Résidence" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="ResidenceBox" Grid.Row="1" Margin="0,0,0,10" SelectionChanged="ResidenceBox_SelectionChanged"/>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,14">
                        <Button Content="Nouvelle" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0" Click="CreateResidence_Click"/>
                        <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Click="EditResidence_Click"/>
                    </UniformGrid>
                    <Button Grid.Row="3" Content="Supprimer la résidence" Style="{StaticResource DangerButton}" Margin="0,0,0,18" Click="DeleteResidence_Click"/>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Recherche" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="SearchBox" ToolTip="Nom, prénom, logement ou numéro de badge" TextChanged="SearchBox_TextChanged" Margin="0,0,0,10"/>
                        <ListBox x:Name="ResidentList" MouseDoubleClick="ResidentList_MouseDoubleClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fiche résident" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ModeText" Grid.Column="1" Text="Nouveau résident" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LastNameBox" ToolTip="Nom" Margin="0,0,5,0"/><TextBox x:Name="FirstNameBox" Grid.Column="1" ToolTip="Prénom" Margin="5,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="PhoneBox" ToolTip="Téléphone" Margin="0,0,5,0"/><TextBox x:Name="EmailBox" Grid.Column="1" ToolTip="E-mail" Margin="5,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BuildingBox" ToolTip="Bâtiment" Margin="0,0,5,0"/><TextBox x:Name="ApartmentBox" Grid.Column="1" ToolTip="Appartement" Margin="5,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FloorBox" ToolTip="Étage" Margin="0,0,5,0"/><TextBox x:Name="DoorBox" Grid.Column="1" ToolTip="Porte" Margin="5,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Badges" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#F5F8FF" BorderBrush="#DCE5FF" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Dernière lecture" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock x:Name="LastBadgeText" Text="Posez un badge sur le lecteur" FontFamily="Consolas" FontSize="25" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="Ajouter manuel" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="AddManualBadge_Click"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="BadgeGrid" Height="220" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Numéro" Binding="{Binding Number}" Width="*"/>
                                <DataGridTextColumn Header="Technologie" Binding="{Binding Technology}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Starprox" Binding="{Binding Starprox}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Columns="2" Margin="0,10,0,16">
                            <Button Content="Modifier badge" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="EditBadge_Click"/>
                            <Button Content="Retirer badge" Style="{StaticResource DangerButton}" Margin="5,0,0,0" Click="RemoveBadge_Click"/>
                        </UniformGrid>

                        <TextBlock Text="Notes résident" Style="{StaticResource SectionTitle}"/>
                        <TextBox x:Name="NotesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="1">
                        <Button Content="Enregistrer le résident" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="SaveResident_Click"/>
                        <Button Content="Enregistrer et suivant" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="SaveNext_Click"/>
                        <Button Content="Nouveau résident" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16" Click="NewResident_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Partage et exports" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Partager / Export CSV" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" Click="Share_Click"/>
                        <Button Content="Exporter la résidence" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="ExportResidence_Click"/>
                        <Button Content="Importer un CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" Click="ImportCsv_Click"/>
                        <Button Content="Sauvegarder la base" Style="{StaticResource SecondaryButton}" Click="BackupDatabase_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="Double-cliquez sur un résident pour le modifier. Ctrl+Entrée : enregistrer et suivant · Échap : vider la fiche." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Prêt" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Column="1" Text="BadgeFlow Desktop 1.0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
