<Window x:Class="BadgeFlow.Desktop.ManagerConversionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Convertir en gestionnaire" Width="720" Height="620" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Icon="Assets/BadgeFlow.ico">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Convertir cette fiche en gestionnaire" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="IntroText" Margin="0,8,0,14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="RowsPanel"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding OriginalName}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox Grid.Column="2" Text="{Binding ProposedName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom de la nouvelle résidence / adresse"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Annuler" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Grid.Column="2" Content="Convertir" Style="{StaticResource PrimaryButton}" Click="Convert_Click"/></Grid>
  </Grid>
</Window>
