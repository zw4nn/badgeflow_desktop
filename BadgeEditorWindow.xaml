<Window x:Class="BadgeFlow.Desktop.BadgeEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Badge" Width="460" Height="500" ResizeMode="CanResizeWithGrip" MinWidth="380" MinHeight="330" WindowStartupLocation="CenterOwner" Icon="Assets/BadgeFlow.ico">
  <Border Style="{StaticResource Card}" Margin="18"><StackPanel>
    <TextBlock x:Name="TitleText" Text="Badge manuel" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock Text="Numéro" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NumberBox" FontFamily="Consolas" FontSize="17" Margin="0,4,0,10"/>
    <TextBlock Text="Technologie" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="TechnologyBox" Margin="0,4,0,10"><ComboBoxItem Content="URMET"/><ComboBoxItem Content="HEXACT"/><ComboBoxItem Content="INTRATONE"/><ComboBoxItem Content="AUTO"/></ComboBox>
    <CheckBox x:Name="StarproxBox" Content="Badge Starprox" Margin="0,4,0,10" FontWeight="SemiBold"/><TextBlock Text="Libellé / référence" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="LabelBox" Margin="0,4,0,10"/>
    <TextBlock Text="Notes" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NotesBox" Height="70" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,4,0,16"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click"/><Button Grid.Column="1" Content="Enregistrer" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Save_Click"/>
    </Grid>
  </StackPanel></Border>
</Window>
