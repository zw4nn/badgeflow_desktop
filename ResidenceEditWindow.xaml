<Window x:Class="BadgeFlow.Desktop.ResidenceEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Résidence" Width="480" Height="410" ResizeMode="CanResizeWithGrip" MinWidth="380" MinHeight="330" WindowStartupLocation="CenterOwner" Icon="Assets/BadgeFlow.ico">
  <Border Style="{StaticResource Card}" Margin="18"><StackPanel>
    <TextBlock x:Name="TitleText" Text="Résidence" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock Text="Nom" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="NameBox" Margin="0,4,0,10"/>
    <TextBlock Text="Adresse" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="AddressBox" Margin="0,4,0,10"/>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Code postal" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PostalCodeBox" Margin="0,4,8,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Ville" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="CityBox" Margin="8,4,0,0"/></StackPanel>
    </Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click"/>
      <Button Grid.Column="1" Content="Enregistrer" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Save_Click"/>
    </Grid>
  </StackPanel></Border>
</Window>
