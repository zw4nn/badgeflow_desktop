<Window x:Class="BadgeFlow.Desktop.ResidenceEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Résidence" Width="620" Height="720" MinWidth="520" MinHeight="580" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Icon="Assets/BadgeFlow.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="18"><StackPanel>
    <TextBlock x:Name="TitleText" Text="Résidence" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBlock Text="Nom" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameBox" Margin="0,0,0,10"/>
    <TextBlock Text="Gestionnaire / agence" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ManagerBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,10"/><TextBlock Text="Adresse" Style="{StaticResource FieldLabel}"/><TextBox x:Name="AddressBox" Margin="0,0,0,10"/>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Code postal" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PostalCodeBox" Margin="0,0,8,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Ville" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CityBox" Margin="8,0,0,0"/></StackPanel>
    </Grid>
    <TextBlock Text="Technologie(s) de badge" Style="{StaticResource SectionTitle}"/>
    <WrapPanel Margin="0,0,0,16"><CheckBox x:Name="UrmetBox" Content="Urmet" Margin="0,0,18,8"/><CheckBox x:Name="HexactBox" Content="Hexact" Margin="0,0,18,8"/><CheckBox x:Name="IntratoneBox" Content="Intratone" Margin="0,0,18,8"/><CheckBox x:Name="StarproxBox" Content="Starprox" Margin="0,0,18,8"/><CheckBox x:Name="OtherBox" Content="Autre" Margin="0,0,18,8"/></WrapPanel>
    <TextBlock Text="Gestion / paramétrage" Style="{StaticResource SectionTitle}"/>
    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ManagementBox" Margin="0,0,0,10"><ComboBoxItem Content="Sur place"/><ComboBoxItem Content="A distance"/><ComboBoxItem Content="Les deux"/></ComboBox>
    <TextBlock Text="Logiciel / portail" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SoftwareBox" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,0,10"/>
    <TextBlock Text="Notes terrain" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ManagementNotesBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="Cancel_Click"/>
      <Button Grid.Column="1" Content="Enregistrer" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0" Click="Save_Click"/>
    </Grid>
  </StackPanel></Border></ScrollViewer>
</Window>
